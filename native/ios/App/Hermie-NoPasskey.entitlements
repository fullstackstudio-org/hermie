<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Hermie.entitlements without the passkey associated domain: what a build with an empty
		HERMIE_PASSKEY_RP_ID signs with. Keep the two files identical otherwise
		(PasskeyBuildSettingsTests checks it).
	-->
	<!-- Push. Distribution signing replaces "development" with the profile's value. -->
	<key>aps-environment</key>
	<string>development</string>
	<!--
		Time Sensitive Notifications: an approval, a question or a confirmation is posted at the
		time-sensitive level, which a Focus lets through (RequestAlerts.timeSensitiveEntitled; the
		reader can turn it off in Settings). The app alone: no extension posts notifications.
	-->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Shared with the widgets, the share extension and the intents. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(HERMIE_BUNDLE_ID)</string>
	</array>
	<!--
		The group the Expo build already writes its credentials to, named first so
		every write lands there and existing items stay readable. Changing it signs
		everybody out.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(HERMIE_BUNDLE_ID)</string>
		<!--
			Second, so no write lands here by default: the share extension's delivery record only,
			written by name (ShareDeliveryPublisher). The extension declares this group alone.
		-->
		<string>$(AppIdentifierPrefix)$(HERMIE_BUNDLE_ID).share</string>
	</array>
</dict>
</plist>
