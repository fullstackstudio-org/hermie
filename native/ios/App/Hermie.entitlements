<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Passkeys: the relying party the system passkey sheet runs under
		(HERMIE_PASSKEY_RP_ID in Config/Shared.xcconfig). The app alone: no extension
		declares it. A build with an empty RP signs with Hermie-NoPasskey.entitlements,
		which is this file without this key.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:$(HERMIE_PASSKEY_RP_ID)</string>
	</array>
	<!-- Push. Distribution signing replaces "development" with the profile's value. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the widgets, the share extension and the intents. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(HERMIE_BUNDLE_ID)</string>
	</array>
	<!--
		The group the Expo build already writes its credentials to, named first so
		every write lands there and existing items stay readable. Changing it signs
		everybody out.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(HERMIE_BUNDLE_ID)</string>
		<!--
			Second, so no write lands here by default: the share extension's delivery record only,
			written by name (ShareDeliveryPublisher). The extension declares this group alone.
		-->
		<string>$(AppIdentifierPrefix)$(HERMIE_BUNDLE_ID).share</string>
	</array>
</dict>
</plist>
