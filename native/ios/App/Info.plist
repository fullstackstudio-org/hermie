<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>nl</string>
		<string>de</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Hermie</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The short commit hash, for the About line. Written by scripts/generate.sh. -->
	<key>HermieCommit</key>
	<string>$(HERMIE_COMMIT)</string>
	<!--
		The passkey relying party (HERMIE_PASSKEY_RP_ID in Config/Shared.xcconfig), read at launch.
		Empty in a build without the associated domain, which never offers passkeys.
	-->
	<key>HermiePasskeyRPID</key>
	<string>$(HERMIE_PASSKEY_RP_ID)</string>
	<!--
		The two keychain groups, team prefix included, for the share extension's delivery record:
		written into the share group, and deleted from the app group where earlier builds wrote it.
	-->
	<key>HermieKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(HERMIE_BUNDLE_ID)</string>
	<key>HermieShareKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(HERMIE_BUNDLE_ID).share</string>
	<!-- The App Group this build's entitlements name (`group.dev.hermie.app` in Release). -->
	<key>HermieAppGroup</key>
	<string>group.$(HERMIE_BUNDLE_ID)</string>
	<!-- NO in a Debug build: it never registers with the push relay (HERMIE_PUSH). -->
	<key>HermiePush</key>
	<string>$(HERMIE_PUSH)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hermie</string>
			</array>
		</dict>
	</array>
	<!-- Hermie uses the platform's TLS and HTTP stacks and no cryptography of its own. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
		The gateway's address is typed by the user, and a gateway on a tailnet is
		normally served in the clear. This key is ALONE on purpose: any of
		NSAllowsLocalNetworking, NSAllowsArbitraryLoadsInWebContent or
		NSAllowsArbitraryLoadsForMedia beside it makes the system ignore it.
		See docs/adr/0014-plain-http-on-private-networks.md.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Hermie adds an event to your calendar when a bot suggests one and you choose to add it. Hermie can only add events: it cannot read your calendar.</string>
	<key>NSCameraUsageDescription</key>
	<string>Hermie uses the camera so you can take a photo, scan a document or read a code, to attach to a message or to send when a bot asks for it.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Hermie uses Face ID to unlock the app.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hermie connects to the gateway at the address you enter, which can be a computer on your local network.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Hermie uses your location once, when you choose to share it because a bot asked for it. It is sent to the gateway you are signed in to and is not kept on this device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hermie uses the microphone so you can dictate a message or record a voice note. Dictation is transcribed on this device and never sent anywhere; a voice note goes to your gateway only when you press Send.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Hermie uses your photo library so you can attach an image to a message.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Hermie adds a reminder when a bot suggests one and you choose to add it. Hermie does not read your other reminders.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Hermie uses on-device speech recognition to turn what you say into the text of a message, or into a transcript of a voice note. Nothing is sent to Apple or to any other service.</string>
	<!--
		Handoff: the open chat is advertised under this type (`HandoffActivity.type` in HermieShared) and
		continued from it. The same string on the iPhone, the iPad and the Mac; the payload is a hermie://
		chat or conversation link and never a word of the conversation.
	-->
	<key>NSUserActivityTypes</key>
	<array>
		<string>dev.hermie.activity.chat</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
