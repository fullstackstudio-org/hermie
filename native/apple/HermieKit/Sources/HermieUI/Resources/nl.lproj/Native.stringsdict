<dict>
	<key>native.chart.summary.more</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>en nog %lld</string>
			<key>other</key>
			<string>en nog %lld</string>
		</dict>
	</dict>
