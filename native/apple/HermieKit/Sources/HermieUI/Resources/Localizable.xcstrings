    "app.settings.lock.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlangt Face ID, Touch ID oder den Code dieses Geräts, bevor Hermie gelesen werden kann. Diese Einstellung bleibt auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask for Face ID, Touch ID or this device’s passcode before Hermie can be read. This setting stays on this device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag om Face ID, Touch ID of de toegangscode van dit apparaat voordat Hermie gelezen kan worden. Deze instelling blijft op dit apparaat."
          }
        }
      }
    },
    "app.settings.lock.hintOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie fragt wieder, wenn es so lange weg war, und immer nach einem frischen Start. Diese Einstellung bleibt auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie asks again after it has been away for this long, and always after it has been started fresh. This setting stays on this device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie vraagt het opnieuw als hij zo lang weg is geweest, en altijd na een verse start. Deze instelling blijft op dit apparaat."
          }
        }
      }
    },
    "app.settings.lock.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
