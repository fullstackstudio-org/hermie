        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hermie-Plugin läuft in deinem Gateway und sendet eine Benachrichtigung, wenn ein Bot Neues hat. Hermie Web mit --push erledigt dieselbe Aufgabe von außen, falls sich kein Plugin installieren lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
