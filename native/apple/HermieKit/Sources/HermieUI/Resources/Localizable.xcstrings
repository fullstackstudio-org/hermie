    "app.onboarding.welcome.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie ist ein Client für Hermes Agent. Es spricht immer nur mit einem Gateway — der Maschine, auf der `hermes serve` läuft — und chattet mit den Bots, die dort leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie is a client for Hermes Agent. It talks to one gateway at a time — the machine running `hermes serve` — and chats with the bots that live there."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie is een client voor Hermes Agent. Het praat met één gateway tegelijk — de machine waarop `hermes serve` draait — en chat met de bots die daar staan."
          }
        }
      }
    },
    "app.onboarding.welcome.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nichts gespeichert, bevor die Verbindung getestet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is stored until the connection has been tested."
