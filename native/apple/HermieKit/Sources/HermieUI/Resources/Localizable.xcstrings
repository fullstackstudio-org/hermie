    "app.settings.notifications.previewHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus sagt eine Benachrichtigung, welcher Bot und was passiert ist. An trägt sie auch die Nachricht mit — und gelesen wird sie auf dem Sperrbildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off, a notification says which bot and what happened. On, it carries the message as well — and a lock screen is where it will be read."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit zegt een melding welke bot het is en wat er gebeurde. Aan draagt hij het bericht ook mee — en een vergrendelscherm is waar dat gelezen wordt."
          }
        }
      }
    },
