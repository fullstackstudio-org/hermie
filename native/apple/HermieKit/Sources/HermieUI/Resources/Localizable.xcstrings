    "app.transport.httpExposed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfaches http:// an eine öffentliche Adresse. Jeder auf dem Weg kann deine Nachrichten und deine Anmeldung mitlesen. Nutze https://, oder erreiche das Gateway über ein privates Netz wie Tailscale."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plain http:// to a public address. Anyone on the path can read your messages and your sign-in. Use https://, or reach the gateway over a private network such as Tailscale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewoon http:// naar een publiek adres. Iedereen op het pad kan je berichten en je inlog lezen. Gebruik https://, of bereik de gateway via een privénetwerk zoals Tailscale."
          }
        }
      }
    },
    "app.transport.httpLocalNetwork" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
