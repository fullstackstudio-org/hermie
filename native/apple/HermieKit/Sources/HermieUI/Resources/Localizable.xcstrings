    "app.settings.gateways.removeNotifyNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dieses Gateway nicht das ist, mit dem Hermie verbunden ist, hören seine Benachrichtigungen erst auf, wenn es das nächste Mal versucht, dieses Gerät zu erreichen — und nicht sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this gateway is not the one Hermie is connected to, its notifications stop when it next tries to reach this device rather than straight away."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is dit niet de gateway waar Hermie mee verbonden is, dan stoppen zijn meldingen pas de volgende keer dat hij dit apparaat probeert te bereiken, en niet meteen."
