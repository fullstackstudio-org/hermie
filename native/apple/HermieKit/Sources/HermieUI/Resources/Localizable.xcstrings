      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bots haben noch nicht miteinander gesprochen. Sobald einer einem anderen schreibt oder eine Aufgabe abgibt, taucht das hier auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
