    "app.settings.lock.refused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie konnte nicht bestätigen, dass du es warst, also wurde nichts geändert. Wähle die Option erneut, um es noch einmal zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie could not confirm it was you, so nothing changed. Choose the option again to try once more."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie kon niet bevestigen dat jij het was, dus is er niets gewijzigd. Kies de optie opnieuw om het nog eens te proberen."
          }
        }
      }
