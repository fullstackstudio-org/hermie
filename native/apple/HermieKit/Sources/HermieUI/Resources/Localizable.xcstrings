          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Hermie-plugin draait in je gateway en stuurt een melding zodra een bot nieuws heeft. Hermie Web met --push doet hetzelfde van buitenaf, als er geen plugin geïnstalleerd kan worden."
          }
        }
      }
    },
