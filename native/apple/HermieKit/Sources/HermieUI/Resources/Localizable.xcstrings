    "app.errors.network" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ war nicht erreichbar. Prüfe die Adresse und ob das Gateway läuft und von diesem Gerät aus erreichbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reach %@. Check the address, and that the gateway is running and reachable from this device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kon niet worden bereikt. Controleer het adres, en of de gateway draait en vanaf dit apparaat bereikbaar is."
          }
        }
      }
    },
    "app.errors.networkOverHttps" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ war über https:// nicht erreichbar. Entweder antwortet es dort nicht, oder es liefert ein Zertifikat, dem dieses Gerät nicht traut. Lass das https:// weg, dann versucht Hermie auch http://."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reach %@ over https://. It is either not answering there, or serving a certificate this device does not trust. Leave the https:// off and Hermie will try http:// as well."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kon niet via https:// worden bereikt. Hij antwoordt daar niet, of hij levert een certificaat dat dit apparaat niet vertrouwt. Laat de https:// weg en Hermie probeert ook http://."
          }
        }
      }
    },
    "app.errors.notHermes" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
