      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway traut dieser Adresse nicht. Setze sein `dashboard.public_url` auf die Adresse, die du eingegeben hast, und starte es neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gateway does not trust this address. Set its `dashboard.public_url` to the address you entered and restart it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
