    "app.auth.noRefreshToken" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anmeldung lässt sich nicht erneuern — sie endet, wenn ihr Access Token abläuft. Der Provider des Gateways braucht den Scope offline_access."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sign-in cannot be refreshed — it ends when its access token expires. The gateway’s provider needs the offline_access scope."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze inlog kan niet worden vernieuwd — hij eindigt zodra zijn access token verloopt. De provider van de gateway heeft de offline_access-scope nodig."
          }
        }
      }
    },
