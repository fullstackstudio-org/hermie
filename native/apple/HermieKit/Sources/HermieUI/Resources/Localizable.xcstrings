    "app.onboarding.signIn.tokenBlockedBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es authentifiziert sich mit einem Session-Token, und ein Browser-Tab hat keinen sicheren Ort dafür — alles, was auf der Seite läuft, könnte es lesen. Nutze die Hermie-App, oder stelle das Gateway hinter einen Identity Provider, damit es eine Browser-Session ausstellen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It authenticates with a session token, and a browser tab has nowhere safe to keep one — anything running in the page could read it. Use the Hermie app, or put the gateway behind an identity provider so it can issue a browser session."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij authenticeert met een session token, en een browsertab heeft geen veilige plek om er een te bewaren — alles wat in de pagina draait zou het kunnen lezen. Gebruik de Hermie-app, of zet de gateway achter een identity provider zodat hij een browsersessie kan uitgeven."
          }
        }
      }
    },
    "app.onboarding.signIn.tokenBlockedTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gateway lässt sich aus einem Browser nicht nutzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This gateway cannot be used from a browser"
