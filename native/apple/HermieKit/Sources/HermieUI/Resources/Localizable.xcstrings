          }
        }
      }
    },
    "app.onboarding.signIn.subtitleCookie" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway hostet die Anmeldeseite. Dein Browser behält die Session, die sie zurückgibt; Hermie bekommt sie nie zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gateway hosts the sign-in page. Your browser keeps the session it hands back; Hermie never sees it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gateway host de inlogpagina. Je browser bewaart de sessie die hij teruggeeft; Hermie ziet die nooit."
          }
        }
      }
    },
    "app.onboarding.signIn.subtitleNative" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway hostet die Anmeldeseite. Hermie öffnet sie, liest das Ergebnis und behält die Token auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gateway hosts the sign-in page. Hermie opens it, reads the result and keeps the tokens on this device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gateway host de inlogpagina. Hermie opent die, leest het resultaat en bewaart de tokens op dit apparaat."
          }
        }
      }
    },
    "app.onboarding.signIn.subtitleToken" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gateway steht nicht hinter einem Identity Provider; es authentifiziert sich mit dem Session-Token, das es beim Start ausgibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This gateway is not gated by an identity provider; it authenticates with the session token it prints at startup."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze gateway zit niet achter een identity provider; hij authenticeert met het session token dat hij bij het starten afdrukt."
          }
        }
      }
    },
    "app.onboarding.signIn.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmelden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
