    "app.errors.authProxy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Access-Proxy hat mit HTTP %lld geantwortet, bevor das Gateway dran war. Füge seine Header unter Erweitert hinzu, oder nimm /api/status, /auth/* und /login davon aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An access proxy answered HTTP %lld before the gateway did. Add its headers under Advanced, or exempt /api/status, /auth/* and /login from it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een access proxy antwoordde met HTTP %lld vóór de gateway. Voeg zijn headers toe onder Geavanceerd, of sluit /api/status, /auth/* en /login ervan uit."
          }
        }
      }
    },
    "app.errors.closeAbnormal" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der WebSocket wurde ohne Grund geschlossen. Ein Proxy vor dem Gateway muss meistens erst so konfiguriert werden, dass er WebSocket-Upgrades durchlässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The WebSocket closed without a reason. A proxy in front of the gateway usually has to be configured to pass WebSocket upgrades through."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De WebSocket ging dicht zonder reden. Een proxy vóór de gateway moet meestal worden ingesteld om WebSocket-upgrades door te laten."
          }
        }
      }
    },
    "app.errors.closeAuth" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway hat die Zugangsdaten abgelehnt, als der WebSocket geöffnet wurde. Melde dich erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gateway rejected the credentials when the WebSocket opened. Sign in again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gateway wees de credentials af toen de WebSocket openging. Log opnieuw in."
          }
        }
      }
    },
