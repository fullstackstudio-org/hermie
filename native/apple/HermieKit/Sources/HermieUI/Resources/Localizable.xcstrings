    "app.settings.botNamesHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcher Name der große ist. Der Profilname ist der, mit dem der Rest der App einen Bot anspricht; der Anzeigename ist das Label, das auf dem Gateway gesetzt ist. Ein Bot mit nur einem von beiden zeigt eine Zeile. Wird nur verwendet, solange Profilname ausblenden, unten, aus ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which name is the large one. The profile name is what the rest of the app addresses a bot by; the display name is the label set on the gateway. A bot with only one of them shows one line. Only used while Hide profile name, below, is off."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welke naam de grote is. De profielnaam is waarmee de rest van de app een bot aanspreekt; de weergavenaam is het label dat op de gateway is ingesteld. Een bot met maar één daarvan toont één regel. Wordt alleen gebruikt terwijl Profielnaam verbergen, hieronder, uit staat."
          }
        }
      }
    },
