    "app.settings.notifications.typesHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bot antwortet, ein Bot fragt um Erlaubnis, die Zustellung einer Routine, wie ein geplanter Lauf geendet ist, und eine lange Aufgabe, die so oder so ihr Ende erreicht. Ein Zug, den du selbst gestoppt hast, ist nie darunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bot answering, a bot asking permission, a routine’s delivery, how a scheduled run ended, and a long task reaching its end either way. A turn you stopped yourself is never one of these."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bot die antwoordt, een bot die toestemming vraagt, de levering van een routine, hoe een geplande run afliep, en een lange taak die hoe dan ook aan zijn eind komt. Een beurt die je zelf hebt gestopt hoort daar nooit bij."
          }
        }
      }
    },
