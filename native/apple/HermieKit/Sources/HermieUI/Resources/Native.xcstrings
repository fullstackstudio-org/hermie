    "native.signIn.portInUse" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App auf diesem Gerät wartet bereits auf eine Anmeldung unter 127.0.0.1:38007 – vielleicht die Hermes-Desktop-App. Beende sie und versuche es erneut, oder melde dich in Hermie an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app on this device is already waiting for a sign-in at 127.0.0.1:38007 — the Hermes desktop app, perhaps. Quit it and try again, or sign in inside Hermie instead."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een andere app op dit apparaat wacht al op een aanmelding op 127.0.0.1:38007 — misschien de Hermes-desktopapp. Sluit die af en probeer het opnieuw, of meld je aan binnen Hermie."
          }
        }
      }
    },
