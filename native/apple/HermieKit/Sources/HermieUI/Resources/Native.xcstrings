        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kwam een passkey-bevestiging binnen die deze app niet kon lezen, dus er is niet op geantwoord."
          }
        }
      }
    },
    "native.passkeys.notice.noCredentialForApp" : {
