    "native.licences.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie ist Open Source unter der MIT-Lizenz. Die Apple-Apps verwenden keine Pakete von Dritten, nur Apples eigene Frameworks. Was sie anderen verdanken, steht unten; tippe auf einen Eintrag, um die Lizenz zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie is open source under the MIT licence. The Apple apps use no third-party packages, only Apple's own frameworks. What they owe to others is below; tap an entry to read its licence."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie is open source onder de MIT-licentie. De Apple-apps gebruiken geen pakketten van derden, alleen de eigen frameworks van Apple. Wat ze aan anderen te danken hebben staat hieronder; tik op een onderdeel om de licentie te lezen."
          }
        }
      }
    },
