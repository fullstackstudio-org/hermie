    "native.icloud.disclosure.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gateways mit iCloud synchronisieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync Gateways with iCloud?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gateways synchroniseren met iCloud?"
          }
        }
      }
    },
    "native.icloud.disclosure.whereBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deinem iCloud-Schlüsselbund, der Ende-zu-Ende-verschlüsselt ist: Apple kann ihn nicht lesen, und wir auch nicht. Er gelangt nur auf Geräte, die mit deinem Apple Account angemeldet sind und die du bestätigt hast. Nichts wird an uns gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In your iCloud Keychain, which is end-to-end encrypted: Apple cannot read it and neither can we. It reaches only devices signed in to your Apple Account that you have approved. Nothing is sent to us."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In je iCloud-sleutelhanger, die end-to-end versleuteld is: Apple kan hem niet lezen en wij ook niet. Hij komt alleen op apparaten die met je Apple-account zijn ingelogd en die je hebt goedgekeurd. Er wordt niets naar ons gestuurd."
          }
        }
      }
    },
    "native.icloud.disclosure.whereHeader" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo es gespeichert wird"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where it is stored"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar het wordt bewaard"
          }
        }
      }
    },
    "native.icloud.disclosure.whereOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie kann nicht sehen, ob der iCloud-Schlüsselbund eingeschaltet ist. Ist er aus, bleibt alles auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie cannot see whether iCloud Keychain is on. If it is off, everything stays on this device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie kan niet zien of de iCloud-sleutelhanger aanstaat. Staat hij uit, dan blijft alles op dit apparaat."
          }
        }
      }
    },
    "native.icloud.failure.keychain" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbund hat die Änderung abgelehnt. Wähle „Jetzt synchronisieren“, um es noch einmal zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keychain refused the change. Choose Sync Now to try again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sleutelhanger weigerde de wijziging. Kies Nu synchroniseren om het opnieuw te proberen."
          }
        }
      }
    },
    "native.icloud.failure.locked" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbund kann nicht gelesen werden, solange dieses Gerät gesperrt ist. Entsperre es und wähle „Jetzt synchronisieren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keychain cannot be read while this device is locked. Unlock it and choose Sync Now."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sleutelhanger is niet te lezen zolang dit apparaat vergrendeld is. Ontgrendel het en kies Nu synchroniseren."
          }
        }
      }
    },
    "native.icloud.failure.newerVersion" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas auf diesem Gerät wurde von einer neueren Hermie-Version geschrieben. Aktualisiere Hermie, um zu synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something on this device was written by a newer version of Hermie. Update Hermie to sync."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets op dit apparaat is door een nieuwere versie van Hermie geschreven. Werk Hermie bij om te synchroniseren."
          }
        }
      }
    },
    "native.icloud.failure.other" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
