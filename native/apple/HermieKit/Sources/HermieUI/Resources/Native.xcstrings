        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een passkey toevoegen door opnieuw in te loggen staat uit op deze gateway. Met een code kan het nog wel."
          }
        }
      }
    },
    "native.passkeys.self.reason.expired" : {
      "comment" : "Settings → Passkeys: the sign-in ran out of time.",
