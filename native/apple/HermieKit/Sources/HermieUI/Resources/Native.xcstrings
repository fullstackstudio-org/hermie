    "native.passkeys.self.reason.authNotFresh" : {
      "comment" : "Settings → Passkeys: the identity provider reused an earlier sign-in.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Identitätsanbieter hat eine frühere Anmeldung wiederverwendet. Melde dich dort ab und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your identity provider reused an earlier sign-in. Sign out there, then try again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je identiteitsprovider gebruikte een eerdere inlog opnieuw. Log daar uit en probeer het opnieuw."
          }
        }
      }
    },
    "native.passkeys.self.reason.authTimeMissing" : {
      "comment" : "Settings → Passkeys: the identity provider does not say when the person signed in.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Identitätsanbieter gibt nicht an, wann du dich angemeldet hast. Wer das Gateway betreibt, kann das erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your identity provider does not say when you signed in. Whoever runs the gateway can allow that."
          }
