    "native.icloud.disclosure.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie kann deine Gateways in deinem iCloud-Schlüsselbund aufbewahren, damit deine anderen Apple-Geräte sie bekommen, ohne dass du etwas eintippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie can keep your gateways in your iCloud Keychain, so your other Apple devices get them without typing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie kan je gateways in je iCloud-sleutelhanger bewaren, zodat je andere Apple-apparaten ze krijgen zonder dat je iets hoeft te typen."
          }
        }
      }
    },
    "native.icloud.disclosure.later" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das jederzeit unter Einstellungen → Gateways → iCloud-Synchronisierung ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change this at any time under Settings → Gateways → iCloud Sync."
          }
        },
        "nl" : {
          "stringUnit" : {
