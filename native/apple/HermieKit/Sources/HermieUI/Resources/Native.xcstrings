            "value" : "Einen Passkey durch erneutes Anmelden hinzuzufügen ist auf diesem Gateway ausgeschaltet. Mit einem Code geht es weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
