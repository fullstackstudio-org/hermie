    "native.push.resetHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieht die Registrierungen dieses Geräts bei jedem noch erreichbaren Gateway zurück, vergisst sie und schaltet Mitteilungen hier aus. Schalte sie danach wieder ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes this device’s registrations back from every gateway it can still reach, forgets them and turns notifications off here. Turn them on again afterwards."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trekt de registraties van dit apparaat in bij elke gateway die nog bereikbaar is, vergeet ze en zet meldingen hier uit. Zet ze daarna weer aan."
          }
        }
      }
    },
    "native.push.resetLeftovers" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Registrierungen konnten noch nicht zurückgezogen werden. Setze erneut zurück, sobald das Gerät online ist."
          }
