    "native.voice.voiceFooter" : {
      "comment" : "Under the Automatic row of the voice list.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stimme, die du wählst, liest Antworten in ihrer eigenen Sprache vor. Eine Antwort in einer anderen Sprache liest die Systemstimme für diese Sprache vor."
          }
        },
        "en" : {
