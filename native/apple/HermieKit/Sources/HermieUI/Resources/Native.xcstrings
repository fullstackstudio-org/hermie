            "value" : "Deze koppeling is verlopen. Log opnieuw in om opnieuw te beginnen."
          }
        }
      }
    },
    "native.passkeys.self.reason.failed" : {
      "comment" : "Settings → Passkeys: the sign-in did not count, for any other reason.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
