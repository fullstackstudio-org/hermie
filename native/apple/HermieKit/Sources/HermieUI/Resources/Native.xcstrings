    "native.interactive.calendar.notSaved" : {
      "comment" : "Said when the person closed the calendar sheet without saving and a skip is not offered.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde nicht gespeichert. Füge es erneut hinzu oder entscheide dich, nichts zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was not saved. Add it again, or choose not to share."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is niet bewaard. Voeg het opnieuw toe, of kies ervoor het niet te delen."
          }
        }
      }
    },
    "native.interactive.calendar.noteDirectEvent" : {
      "comment" : "Said under the Add button on the Mac: Add saves the event after the system's permission question.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Hinzufügen“ speichert dies in deinem Standardkalender. Das System fragt zuerst, ob Hermie Termine hinzufügen darf (nur Schreibzugriff: Hermie kann deinen Kalender nicht lesen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add saves this to your default calendar. The system asks first whether Hermie may add events (write only: Hermie cannot read your calendar)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toevoegen bewaart dit in je standaardagenda. Het systeem vraagt eerst of Hermie afspraken mag toevoegen (alleen schrijven: Hermie kan je agenda niet lezen)."
          }
        }
      }
    },
    "native.interactive.calendar.noteEditor" : {
      "comment" : "Said under the Add button on iPhone and iPad: the system's calendar sheet opens next.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nichts hinzugefügt, bis du es im Kalender-Dialog des Systems speicherst, der sich danach öffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is added until you save it in the system’s calendar sheet that opens next."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt niets toegevoegd tot je het opslaat in het agenda-scherm van het systeem dat daarna opent."
          }
        }
      }
    },
    "native.interactive.calendar.noteReminder" : {
      "comment" : "Said under the Add button for a reminder: Add saves it after the system's permission question.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Hinzufügen“ speichert dies in deiner Standardliste in Erinnerungen. Das System fragt zuerst, ob Hermie auf Erinnerungen zugreifen darf. Es bietet dafür nur vollen Zugriff an; Hermie fügt nur diese eine Erinnerung hinzu und liest deine anderen nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add saves this to your default Reminders list. The system asks first whether Hermie may use Reminders. It only offers full access for that; Hermie adds this one reminder and does not read your others."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toevoegen bewaart dit in je standaardlijst in Herinneringen. Het systeem vraagt eerst of Hermie Herinneringen mag gebruiken. Daarvoor biedt het alleen volledige toegang aan; Hermie voegt alleen deze ene herinnering toe en leest je andere niet."
          }
        }
      }
    },
    "native.interactive.calendar.notes" : {
      "comment" : "Label of the notes of an event or reminder.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
