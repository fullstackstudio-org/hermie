    },
    "native.intents.botNotHere" : {
      "comment" : "A Shortcut named a bot that is not on the gateway the app is connected to. The argument is the bot's name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht auf dem Gateway, mit dem Hermie verbunden ist, deshalb wurde nichts gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not on the gateway Hermie is connected to, so nothing was sent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ staat niet op de gateway waarmee Hermie verbonden is, dus er is niets verstuurd."
          }
        }
      }
    },
    "native.intents.expired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie hat zu lange zum Öffnen gebraucht, deshalb wurde nichts gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie took too long to open, so nothing was sent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie deed er te lang over om te openen, dus er is niets verstuurd."
          }
        }
      }
    },
    "native.intents.gatewayGone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway dieses Bots ist nicht mehr in Hermie, deshalb wurde nichts gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That bot's gateway is no longer in Hermie, so nothing was sent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gateway van die bot staat niet meer in Hermie, dus er is niets verstuurd."
          }
        }
      }
    },
    "native.intents.queued" : {
      "comment" : "A Shortcut sent a message while the bot was still answering an earlier one; it is queued in the app and goes out when that answer ends. The argument is the bot's name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ beantwortet noch eine frühere Nachricht. Deine steht in Hermie in der Warteschlange und geht raus, sobald diese Antwort fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is still answering an earlier message. Yours is queued in Hermie and goes out when that answer is done."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is nog bezig met een eerder bericht. Het jouwe staat in Hermie in de wachtrij en gaat eruit zodra dat antwoord klaar is."
          }
        }
      }
    },
    "native.intents.stillWorking" : {
      "comment" : "A Shortcut's “Ask” ran out of time while the bot was still answering. The argument is the bot's name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ arbeitet noch. Die Nachricht wurde gesendet: Öffne Hermie, um die Antwort zu lesen, oder nutze „Senden an“ für Anfragen, die länger dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is still working. The message was sent: open Hermie to read the reply, or use “Send to” for prompts that take a while."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is nog bezig. Het bericht is verstuurd: open Hermie om het antwoord te lezen, of gebruik “Stuur naar” voor vragen die even duren."
          }
        }
      }
    },
    "native.intents.unreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie konnte diese Anfrage nicht lesen. Vielleicht stammt sie von einer neueren Version."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie could not read that request. It may have been made by a newer version."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie kon dat verzoek niet lezen. Misschien is het gemaakt door een nieuwere versie."
          }
        }
      }
    },
    "native.intents.withdrawn" : {
      "comment" : "A Shortcut's queued message was taken back out of the queue in the app (edited or deleted) before it went out.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht wurde in Hermie aus der Warteschlange genommen, bevor sie rausging, deshalb wurde nichts gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The message was taken back out of the queue in Hermie before it went out, so nothing was sent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bericht is in Hermie uit de wachtrij gehaald voordat het eruit ging, dus er is niets verstuurd."
          }
        }
      }
    },
    "native.later" : {
