    "native.signIn.browserHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldeseite öffnet sich in deinem Browser, wo deine bestehende Anmeldung und das automatische Ausfüllen von Passwörtern verfügbar sind. Hermie erhält nur das Ergebnis, auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in page opens in your browser, where your existing sign-in and its password AutoFill are available. Hermie only receives the result, on this device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanmeldpagina opent in je browser, waar je bestaande aanmelding en het automatisch invullen van wachtwoorden beschikbaar zijn. Hermie ontvangt alleen het resultaat, op dit apparaat."
          }
        }
      }
    },
    "native.signIn.browserMayBeRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert nur, wenn die Access-Richtlinie dich auch als Person im Browser anmelden lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only works when the Access policy also lets you sign in as a person in the browser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt alleen als het Access-beleid je ook als persoon in de browser laat inloggen."
          }
        }
      }
    },
    "native.signIn.browserUnavailable" : {
      "extractionState" : "manual",
