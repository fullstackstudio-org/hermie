    "native.icloud.remove.allDevices" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von allen Geräten entfernen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove from All Devices"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van alle apparaten verwijderen"
          }
        }
      }
    },
    "native.icloud.remove.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von diesem Gerät: Es bleibt im iCloud-Schlüsselbund und auf deinen anderen Geräten und kommt hier nicht zurück. Von allen Geräten: Es wird aus dem iCloud-Schlüsselbund entfernt und von jedem deiner Geräte, sobald es synchronisiert. So oder so vergisst dieses Gerät alles, was dafür gespeichert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From this device: it stays in iCloud Keychain and on your other devices, and does not come back here. From all devices: it is removed from iCloud Keychain, and from each of your devices the next time it syncs. Either way, this device forgets everything stored for it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van dit apparaat: hij blijft in de iCloud-sleutelhanger en op je andere apparaten, en komt hier niet terug. Van alle apparaten: hij verdwijnt uit de iCloud-sleutelhanger, en van elk van je apparaten zodra dat synchroniseert. Hoe dan ook vergeet dit apparaat alles wat ervoor bewaard is."
          }
        }
      }
    },
