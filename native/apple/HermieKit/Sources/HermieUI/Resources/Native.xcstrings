    "native.chatList.settings.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege deine Chats in Ordnern ab, gib einem Ordner eine Farbe und wähle, wohin jeder Chat gehört. Beim Löschen eines Ordners bleiben die Chats erhalten. Es folgt dir auf deine anderen Geräte, auf denen du angemeldet bist."
          }
