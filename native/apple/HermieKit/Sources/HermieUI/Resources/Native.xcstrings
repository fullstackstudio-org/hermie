          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggen via een identiteitsprovider of een wachtwoord. Elk apparaat logt zelf in."
          }
        }
      }
    },
    "native.icloud.disclosure.storedHeader" : {
