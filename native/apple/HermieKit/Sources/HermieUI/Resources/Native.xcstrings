          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldeseite öffnet sich in deinem Browser, wo deine bestehende Anmeldung und das automatische Ausfüllen von Passwörtern verfügbar sind. Hermie erhält nur das Ergebnis, auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in page opens in your browser, where your existing sign-in and its password AutoFill are available. Hermie only receives the result, on this device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanmeldpagina opent in je browser, waar je bestaande aanmelding en het automatisch invullen van wachtwoorden beschikbaar zijn. Hermie ontvangt alleen het resultaat, op dit apparaat."
          }
        }
      }
    },
    "native.signIn.browserMayBeRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert nur, wenn die Access-Richtlinie dich auch als Person im Browser anmelden lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only works when the Access policy also lets you sign in as a person in the browser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt alleen als het Access-beleid je ook als persoon in de browser laat inloggen."
          }
        }
      }
    },
    "native.signIn.browserUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung im Browser konnte nicht geöffnet werden. Melde dich stattdessen in Hermie an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The browser sign-in could not be opened. Sign in inside Hermie instead."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanmelding in de browser kon niet worden geopend. Meld je in plaats daarvan aan binnen Hermie."
          }
        }
      }
    },
    "native.signIn.checking" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim Gateway geprüft…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking with the gateway…"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleren bij de gateway…"
          }
        }
      }
    },
    "native.signIn.headersNeedInApp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gateway braucht zusätzliche Header, die dein Browser nicht mitsenden kann, deshalb meldest du dich in Hermie an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This gateway needs extra headers, which your browser cannot send, so you sign in inside Hermie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze gateway heeft extra headers nodig die je browser niet kan meesturen, dus je meldt je aan binnen Hermie."
          }
        }
      }
    },
    "native.signIn.inApp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probleme? In Hermie anmelden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Having trouble? Sign in inside Hermie"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukt het niet? Meld je aan binnen Hermie"
          }
        }
      }
    },
    "native.signIn.inAppHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Anmeldeseite des Gateways in Hermie statt in deinem Browser. Hermie vergisst die Cookies dieser Seite danach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the gateway’s sign-in page inside Hermie instead of your browser. Hermie forgets that page’s cookies afterwards."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent de aanmeldpagina van de gateway binnen Hermie in plaats van in je browser. Hermie vergeet de cookies van die pagina daarna."
          }
        }
      }
    },
    "native.signIn.listenerUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie konnte auf diesem Gerät nicht auf das Ergebnis der Anmeldung warten. Melde dich stattdessen in Hermie an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie could not wait for the sign-in result on this device. Sign in inside Hermie instead."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie kon op dit apparaat niet wachten op het resultaat van de aanmelding. Meld je in plaats daarvan aan binnen Hermie."
          }
        }
      }
    },
    "native.signIn.loadFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen dieses Gateways konnten auf diesem Gerät nicht gelesen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The settings of this gateway could not be read on this device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De instellingen van deze gateway konden op dit apparaat niet worden gelezen."
          }
        }
      }
    },
    "native.signIn.pageLoadFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldeseite konnte nicht geladen werden. Prüfe die öffentliche Adresse des Gateways."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in page could not be loaded. Check the gateway’s public address."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanmeldpagina kon niet worden geladen. Controleer het openbare adres van de gateway."
          }
        }
      }
    },
    "native.signIn.portInUse" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App auf diesem Gerät wartet bereits auf eine Anmeldung unter 127.0.0.1:38007 – vielleicht die Hermes-Desktop-App. Beende sie und versuche es erneut, oder melde dich in Hermie an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app on this device is already waiting for a sign-in at 127.0.0.1:38007 — the Hermes desktop app, perhaps. Quit it and try again, or sign in inside Hermie instead."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een andere app op dit apparaat wacht al op een aanmelding op 127.0.0.1:38007 — misschien de Hermes-desktopapp. Sluit die af en probeer het opnieuw, of meld je aan binnen Hermie."
          }
        }
      }
    },
    "native.signIn.providerRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway oder sein Identitätsanbieter hat die Anmeldung abgelehnt. Versuche es erneut oder frage, wer das Gateway betreibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gateway or its identity provider refused the sign-in. Try again, or ask whoever runs the gateway."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gateway of de identiteitsprovider weigerde de aanmelding. Probeer het opnieuw, of vraag het aan wie de gateway beheert."
          }
        }
      }
    },
    "native.signIn.tokenRejected" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway hat dieses Sitzungstoken nicht akzeptiert. Kopiere es erneut von dem Rechner, auf dem hermes serve läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gateway did not accept this session token. Copy it again from the machine running hermes serve."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gateway accepteerde dit sessietoken niet. Kopieer het opnieuw van de machine waarop hermes serve draait."
          }
        }
      }
    },
    "native.signIn.useBrowserInstead" : {
      "extractionState" : "manual",
      "localizations" : {
