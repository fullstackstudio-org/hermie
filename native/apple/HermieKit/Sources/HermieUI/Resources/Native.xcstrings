    "native.icloud.notice.adopted" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus dem iCloud-Schlüsselbund hinzugefügt:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
