    "native.passkeys.notice.expiredOnArrival" : {
      "comment" : "Notice: a confirmation arrived already expired.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kam eine Passkey-Bestätigung an, die bereits abgelaufen war, daher wurde sie nicht angezeigt. Prüfe, ob Datum und Uhrzeit dieses Geräts stimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A passkey confirmation arrived that had already expired, so it was not shown. Check that the date and time on this device are right."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kwam een passkey-bevestiging binnen die al verlopen was, dus die is niet getoond. Controleer of de datum en tijd op dit apparaat kloppen."
          }
        }
      }
    },
    "native.passkeys.notice.gatewayIDConflict" : {
      "comment" : "Notice: the gateway presents an identity that belongs to another gateway.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bestätigung mit Passkey ist für dieses Gateway aus: Es zeigt eine Identität, die zu einem anderen Gateway gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passkey confirmations are off for this gateway: it presents an identity that belongs to another gateway."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestigen met een passkey staat uit voor deze gateway: hij toont een identiteit die bij een andere gateway hoort."
          }
        }
      }
    },
    "native.passkeys.notice.gatewayIDMismatch" : {
      "comment" : "Notice: the gateway no longer presents the identity its passkeys were set up with.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bestätigung mit Passkey ist für dieses Gateway aus: Es meldet sich nicht mehr als das Gateway, für das du Passkeys eingerichtet hast. Wurde es absichtlich zurückgesetzt, entferne es und füge es erneut hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passkey confirmations are off for this gateway: it no longer identifies itself as the one you set passkeys up with. If it was reset on purpose, remove it and add it again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestigen met een passkey staat uit voor deze gateway: hij meldt zich niet meer als de gateway waarvoor je passkeys hebt ingesteld. Is hij met opzet gereset, verwijder hem dan en voeg hem opnieuw toe."
          }
        }
      }
    },
    "native.passkeys.notice.malformedRequest" : {
      "comment" : "Notice: a confirmation this app could not read.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kam eine Passkey-Bestätigung an, die diese App nicht lesen konnte, daher wurde sie nicht beantwortet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A passkey confirmation arrived that this app could not read, so it was not answered."
          }
