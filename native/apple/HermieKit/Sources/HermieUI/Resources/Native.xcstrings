    "native.icloud.turnOff.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gateways bleiben auf diesem Gerät. Du kannst die Gateways, die dieses Gerät synchronisiert hat, auch aus dem iCloud-Schlüsselbund entfernen; deine anderen Geräte behalten ihre Kopie, jeweils nur auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your gateways stay on this device. You can also remove the gateways this device synced from iCloud Keychain; your other devices keep their copies, each on that device only."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gateways blijven op dit apparaat. Je kunt de gateways die dit apparaat synchroniseerde ook uit de iCloud-sleutelhanger halen; je andere apparaten houden hun kopie, elk alleen op dat apparaat."
          }
        }
      }
    },
