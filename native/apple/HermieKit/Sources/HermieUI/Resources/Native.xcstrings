      }
    },
    "native.icloud.notice.header" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht deine Aufmerksamkeit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needs your attention"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt je aandacht"
          }
        }
      }
    },
    "native.icloud.notice.keptHere" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gateways wurden auf einem anderen Gerät von allen Geräten entfernt. Sie bleiben hier, weil sie hier zuerst hinzugefügt wurden. Erneutes Synchronisieren bringt sie auf anderen Geräten nicht zurück; soll eines wieder auf jedem Gerät sein, entferne es hier und füge es erneut hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These gateways were removed from all devices on another device. They are kept here because they were added here first. Syncing again does not bring them back on other devices; to have one on every device again, remove it here and add it again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze gateways zijn op een ander apparaat van alle apparaten verwijderd. Ze blijven hier, omdat ze hier eerder zijn toegevoegd. Opnieuw synchroniseren brengt ze niet terug op andere apparaten; wil je er een weer op elk apparaat, verwijder hem dan hier en voeg hem opnieuw toe."
          }
        }
      }
    },
    "native.icloud.notice.needsSignIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus dem iCloud-Schlüsselbund hinzugefügt. Melde dich an, um diese Gateways auf diesem Gerät zu nutzen:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added from iCloud Keychain. Sign in to use these gateways on this device:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegevoegd uit de iCloud-sleutelhanger. Log in om deze gateways op dit apparaat te gebruiken:"
          }
        }
      }
    },
    "native.icloud.notice.removedElsewhere" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gateway wurde auf einem anderen Gerät von allen Geräten entfernt, deshalb auch von diesem:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This gateway was removed from all devices on another device, so it is gone from this one too:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze gateway is op een ander apparaat van alle apparaten verwijderd, dus ook van dit apparaat:"
          }
        }
      }
    },
    "native.icloud.notice.storeEmptied" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iCloud-Schlüsselbund enthält diese Gateways nicht mehr, deshalb bleiben sie nur auf diesem Gerät. Das passiert nach „Alles aus dem iCloud-Schlüsselbund löschen“ auf einem anderen Gerät oder wenn die Kopie des iCloud-Schlüsselbunds auf diesem Gerät zurückgesetzt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Keychain no longer holds these gateways, so they are kept on this device only. This happens after “Delete Everything from iCloud Keychain” on another device, or when this device’s copy of iCloud Keychain was reset."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De iCloud-sleutelhanger bevat deze gateways niet meer, dus ze blijven alleen op dit apparaat. Dat gebeurt na ‘Alles uit de iCloud-sleutelhanger verwijderen’ op een ander apparaat, of als de kopie van de iCloud-sleutelhanger op dit apparaat opnieuw is ingesteld."
          }
        }
      }
    },
