    "native.lock.coverLabel" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie ist ausgeblendet, solange die App nicht im Vordergrund ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie is hidden while it is not in front."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie is verborgen zolang de app niet vooraan staat."
          }
        }
      }
    },
    "native.lock.settingUnknown" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sperreinstellung konnte nicht gelesen werden, daher sperrt sich Hermie jedes Mal, wenn du die App verlässt. Wähle eine Einstellung, die bleiben soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lock setting could not be read, so Hermie locks every time you leave it. Choose a setting to keep."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vergrendelinstelling kon niet worden gelezen, dus Hermie vergrendelt elke keer dat je de app verlaat. Kies een instelling om te bewaren."
          }
        }
      }
    },
    "native.notice.gatewayNotConfigured" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link gehört zu einem Gateway, das dieses Gerät nicht kennt. Füge das Gateway zuerst hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That link is for a gateway this device does not know. Add the gateway first."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die link hoort bij een gateway die dit apparaat niet kent. Voeg de gateway eerst toe."
          }
        }
      }
    },
    "native.notice.lockSettingNotRestored" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellung der App-Sperre konnte nicht wiederhergestellt werden. Prüfe sie unter Datenschutz und Sicherheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app lock setting could not be restored. Check it under Privacy & security."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De instelling van de app-vergrendeling kon niet worden hersteld. Controleer haar onder Privacy en beveiliging."
          }
        }
      }
    },
    "native.notice.noGateway" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte zuerst ein Gateway ein und öffne den Link dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up a gateway first, then open the link again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel eerst een gateway in en open de link daarna opnieuw."
          }
        }
      }
    },
    "native.notice.recovered" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die lokalen Daten von Hermie waren beschädigt und wurden neu angelegt. Alles, was noch lesbar war, wurde behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie’s local data was damaged and has been rebuilt. Everything that could still be read was kept."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lokale gegevens van Hermie waren beschadigd en zijn opnieuw opgebouwd. Alles wat nog leesbaar was, is bewaard."
          }
        }
      }
    },
    "native.notice.runningInMemory" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie konnte seinen Speicher nicht öffnen. Was du jetzt änderst, geht verloren, sobald Hermie beendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie could not open its storage. Nothing you change now is kept after Hermie quits."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermie kon zijn opslag niet openen. Wat je nu verandert, is weg zodra Hermie stopt."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
