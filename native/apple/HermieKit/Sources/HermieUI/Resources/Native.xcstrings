      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist auf diesem Gateway anonym: Deine Nachrichten tragen keinen Namen."
          }
        },
        "en" : {
          "stringUnit" : {
