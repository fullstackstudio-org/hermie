          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een stem die je kiest leest antwoorden in zijn eigen taal voor. Een antwoord in een andere taal wordt voorgelezen door de stem van het systeem voor die taal."
          }
        }
      }
    },
    "native.voice.voiceModeFooter" : {
      "comment" : "Settings › Voice: the voice mode section's footer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sprachmodus ist ein Gespräch mit einem Bot: Er hört auf diesem Gerät zu, sendet nach einer Pause, was du gesagt hast, und liest die Antwort vor, während sie eintrifft. Freigaben und Fragen werden nie per Stimme beantwortet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice mode is a call with a bot: it listens on this device, sends what you said after a pause, and reads the reply aloud as it arrives. Approvals and questions are never answered by voice."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemmodus is een gesprek met een bot: hij luistert op dit apparaat, verstuurt wat je zei na een pauze en leest het antwoord voor terwijl het binnenkomt. Goedkeuringen en vragen worden nooit met je stem beantwoord."
          }
        }
      }
    },
