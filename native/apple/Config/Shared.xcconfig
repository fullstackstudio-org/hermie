// Build settings both app targets share, for every configuration.
//
// Order matters: later assignments win. The defaults below are what a checkout
// without git, or a project opened without running scripts/generate.sh, builds
// with; the two optional includes at the end override them.

#include "Version.xcconfig"

// Identity. The same bundle id on iPhone, iPad and the Mac: one App Store
// Connect record, and the keychain items and App Group the Expo build already
// writes.
//
// HERMIE_BUNDLE_ID is the root every identifier is built from: the app's bundle
// id, the extensions' (`.widgets`, `.share`), the App Group (`group.<root>`) and
// the keychain groups (`<team>.<root>`, `<team>.<root>.share`), in the specs, the
// entitlements and the Info.plists alike. Release (the archive, TestFlight, the
// App Store) is `dev.hermie.app`. A Debug build is `dev.hermie.app.dev`, so a dev
// or test run is another app to the system: its own preferences, sandbox
// container, App Group, keychain items and iCloud Keychain items, and it can
// never read or write those of an installed Hermie.
HERMIE_BUNDLE_ID = dev.hermie.app
HERMIE_BUNDLE_ID[config=Debug] = dev.hermie.app.dev
PRODUCT_NAME = Hermie
PRODUCT_BUNDLE_IDENTIFIER = $(HERMIE_BUNDLE_ID)

// Toolchain floor: Xcode 26. Anything newer than the 26 SDK goes behind
// `if #available`.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_HARDENED_RUNTIME = YES
DEAD_CODE_STRIPPING = YES

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Which build this is. Fallbacks only; Build.generated.xcconfig replaces both.
CURRENT_PROJECT_VERSION = 1
HERMIE_COMMIT = dev

// Passkeys (docs/native.md, "Confirm at level passkey"). The relying party the
// app's passkey ceremonies run under: it becomes the app's
// `webcredentials:` associated domain and the Info.plist key
// HermiePasskeyRPID, which the app reads at launch. The host must serve
// /.well-known/apple-app-site-association naming this app's id. A fork with
// its own bundle id sets its own host here; an empty value builds an app with
// no associated domain that never offers passkeys.
HERMIE_PASSKEY_RP_ID = confirm.hermie.dev

// The entitlements file the apps sign with: Hermie.entitlements, or
// Hermie-NoPasskey.entitlements (the same without the associated domain) when
// HERMIE_PASSKEY_RP_ID is empty. A host never names a setting, so only the
// empty value finds HERMIE_ENTITLEMENTS_SUFFIX_.
HERMIE_ENTITLEMENTS_SUFFIX_ = -NoPasskey
HERMIE_ENTITLEMENTS_SUFFIX = $(HERMIE_ENTITLEMENTS_SUFFIX_$(HERMIE_PASSKEY_RP_ID))

// Signing. No team id is ever committed: it comes from HERMIE_TEAM_ID in the
// environment (xcodebuild passes environment variables through as build
// settings) or from a local Signing.xcconfig. With neither, a simulator or an
// unsigned Mac build still works.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = $(HERMIE_TEAM_ID)

// Written by scripts/generate.sh, ignored by git.
#include? "Build.generated.xcconfig"

// A copy of Signing.xcconfig.example, ignored by git.
#include? "Signing.xcconfig"
