// Build settings both app targets share, for every configuration.
//
// Order matters: later assignments win. The defaults below are what a checkout
// without git, or a project opened without running scripts/generate.sh, builds
// with; the two optional includes at the end override them.

#include "Version.xcconfig"

// Identity. The same bundle id on iPhone, iPad and the Mac: one App Store
// Connect record, and the keychain items and App Group the Expo build already
// writes.
PRODUCT_NAME = Hermie
PRODUCT_BUNDLE_IDENTIFIER = dev.hermie.app

// Toolchain floor: Xcode 26. Anything newer than the 26 SDK goes behind
// `if #available`.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_HARDENED_RUNTIME = YES
DEAD_CODE_STRIPPING = YES

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Which build this is. Fallbacks only; Build.generated.xcconfig replaces both.
CURRENT_PROJECT_VERSION = 1
HERMIE_COMMIT = dev

// Signing. No team id is ever committed: it comes from HERMIE_TEAM_ID in the
// environment (xcodebuild passes environment variables through as build
// settings) or from a local Signing.xcconfig. With neither, a simulator or an
// unsigned Mac build still works.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = $(HERMIE_TEAM_ID)

// Written by scripts/generate.sh, ignored by git.
#include? "Build.generated.xcconfig"

// A copy of Signing.xcconfig.example, ignored by git.
#include? "Signing.xcconfig"
