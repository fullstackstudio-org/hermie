<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Every Mac app extension is sandboxed. The share extension reads what it is handed, writes the
		outbox into the App Group, and may dial the gateway the app is signed in to (ADR-0026).
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The same group as native/macos/App/Hermie.entitlements. Change both sides, or neither. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.hermie.app</string>
	</array>
	<!-- Only the delivery record's own keychain group; see HermieShare-iOS.entitlements. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.hermie.app.share</string>
	</array>
</dict>
</plist>
