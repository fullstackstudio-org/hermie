<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		The same group the app and the widget extension name, and the ONLY reason this extension can
		hand anything over: a share extension is its own sandboxed process that is killed the moment
		its sheet closes, so a file it writes into its own container is a file nothing will ever read.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(HERMIE_BUNDLE_ID)</string>
	</array>
	<!--
		The keychain group of the one delivery credential (ADR-0026), and ONLY that group. The app
		writes the record into it by name; the app's own group, with every gateway's refresh and
		session tokens, is not declared here, so this process (which parses whatever another app
		shares and talks to the network) cannot read any of them.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(HERMIE_BUNDLE_ID).share</string>
	</array>
</dict>
</plist>
