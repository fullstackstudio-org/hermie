<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		The sandbox, opened for exactly what the app does: dial the gateway, read
		and write files the user picks (attachments, exports), and dictate.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
		The browser sign-in's loopback listener (RFC 8252): 127.0.0.1:38007, bound
		only while a sign-in waits for its redirect. Nothing else listens.
	-->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Push. Distribution signing replaces "development" with the profile's value. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<!-- Shared with the widgets, the share extension and the intents. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.hermie.app</string>
	</array>
	<!--
		The same group, and the same item shape, as on iPhone and iPad. Changing it
		signs everybody out.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.hermie.app</string>
		<!--
			Second, so no write lands here by default: the share extension's delivery record only,
			written by name (ShareDeliveryPublisher). The extension declares this group alone.
		-->
		<string>$(AppIdentifierPrefix)dev.hermie.app.share</string>
	</array>
</dict>
</plist>
