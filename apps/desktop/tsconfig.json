{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The shell's own pages (`connect.html`, `offline.html`) run in a
    // browser-grade webview, not Node — no React, no React Native Web (that
    // is `expo/hermie`, a separate world this package never imports).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "src-tauri"]
}
