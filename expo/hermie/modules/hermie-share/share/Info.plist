<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleDisplayName</key>
  <string>Hermie</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>XPC!</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionPointIdentifier</key>
    <string>com.apple.share-services</string>
    <!--
      The Swift class below is exposed to the Objective-C runtime under exactly
      this name — see the `@objc(ShareViewController)` on it. A Swift class
      without that attribute is mangled to `HermieShareExtension.ShareViewController`,
      the loader finds nothing under the name here, and the share sheet shows a
      blank sheet with no error anywhere.
    -->
    <key>NSExtensionPrincipalClass</key>
    <string>ShareViewController</string>
    <key>NSExtensionAttributes</key>
    <dict>
      <!--
        What Hermie offers to accept.

        The counts match `SHARE_ITEM_LIMIT` in `src/features/share/outbox.ts`,
        so the cut is made by the system — where the person can still see which
        of their twenty photographs were taken — rather than silently by the
        parser afterwards.

        There is no `NSExtensionActivationSupportsAttachmentsWithMaxCount`
        catch-all on purpose. A share extension that claims everything appears
        in every sheet on the device, including ones where "send this to a chat
        bot" makes no sense, and a row nobody wants is worse than a missing one.
      -->
      <key>NSExtensionActivationRule</key>
      <dict>
        <key>NSExtensionActivationSupportsImageWithMaxCount</key>
        <integer>12</integer>
        <key>NSExtensionActivationSupportsMovieWithMaxCount</key>
        <integer>4</integer>
        <key>NSExtensionActivationSupportsFileWithMaxCount</key>
        <integer>12</integer>
        <key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
        <integer>1</integer>
        <key>NSExtensionActivationSupportsText</key>
        <true/>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
