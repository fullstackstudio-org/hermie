<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      The extension's half of the App Group. The app's half is written into its own entitlements
      by plugin/with-hermie-widgets.js, which also asserts that this file still names the same
      group — two sandboxes that disagree about the group share nothing, and the failure is a
      widget that is permanently empty rather than an error anybody sees.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
      <string>group.dev.hermie.app</string>
    </array>
  </dict>
</plist>
