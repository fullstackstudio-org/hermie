# Dependencies
node_modules/

# Build output
dist/
coverage/
# The web client's source maps (written beside `dist/`, never into it) and the
# declaration output of its type-check.
dist-maps/
native/web/.tsbuild/
# The development-only harness build (`vite build --mode harness`) and what
# Playwright leaves behind.
native/web/dist-harness/
native/web/test-results/
native/web/playwright-report/
*.tsbuildinfo

# Expo / continuous native generation — regenerate with `npx expo prebuild`
.expo/
expo/hermie/ios/
expo/hermie/android/

# Gradle's output for the local Expo modules, whose `android/` IS committed —
# so unlike the generated project above, only the build directories go.
expo/hermie/modules/*/android/build/
expo/hermie/modules/*/android/.gradle/
expo/hermie/modules/*/android/.cxx/

# Xcode build products, including the wrapped Mac bundle `npm run mac` writes
DerivedData/
expo/hermie/build/

# Rust build output for the desktop shell (`apps/desktop/dist` is covered by
# the generic `dist/` rule above).
apps/desktop/src-tauri/target/
# The capability JSON schema Tauri writes next to `capabilities/` on every
# build, for editor autocomplete; regenerated, not authored.
apps/desktop/src-tauri/gen/

# Screenshots from a simulator QA walk. Evidence for one round, not a fixture:
# they are named after the device and the day, they go stale the moment a
# surface changes, and a repository is not where a hundred PNGs of the same
# app belong. The findings go in the round's report and in docs/.
qa/

# Logs and local state
*.log
npm-debug.log*
yarn-error.log*
.env
.env.local

# Editors and OS
.DS_Store
.idea/
*.swp

# Manual QA captures: simulator screenshots from a walk-through, kept out of the
# tree because they are evidence for one round, not an asset the app builds from.
qa/
