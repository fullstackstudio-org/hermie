  {
    "calls": [
      {
        "args": [
          "[IMPORTANT: Background process proc-2f9c completed (exit code 0).\nCommand: /usr/bin/python3 /opt/hermes/tools/bot_mode_dm.py --run-delivery query-file /root/.hermes/dm/2f9c.json hermes -p writer chat -c \"Bot Chat\" -Q -q @/root/.hermes/dm/2f9c.json\nOutput:\nMessage from 🤖 Writer (@writer): Draft is ready, I pushed it to the shared folder.]"
        ],
        "op": "parseProcessCompleteText",
        "result": [
          {
            "command": "/usr/bin/python3 /opt/hermes/tools/bot_mode_dm.py --run-delivery query-file /root/.hermes/dm/2f9c.json hermes -p writer chat -c \"Bot Chat\" -Q -q @/root/.hermes/dm/2f9c.json",
            "output": "Message from 🤖 Writer (@writer): Draft is ready, I pushed it to the shared folder.",
            "sid": "proc-2f9c"
          }
        ]
      }
    ],
    "test": "parseProcessCompleteText > reads one completion block"
  },
  {
    "calls": [
      {
        "args": [
          "2 background processes completed.\n\n[IMPORTANT: Background process proc-2f9c completed (exit code 0).\nCommand: /usr/bin/python3 /opt/hermes/tools/bot_mode_dm.py --run-delivery query-file /root/.hermes/dm/2f9c.json hermes -p writer chat -c \"Bot Chat\" -Q -q @/root/.hermes/dm/2f9c.json\nOutput:\nMessage from 🤖 Writer (@writer): Draft is ready, I pushed it to the shared folder.]\n\n[IMPORTANT: Background process proc-aa01 exited (exit code 1).\nCommand: npm run build\nOutput:\nerror TS2345: Argument of type string is not assignable.]"
        ],
        "op": "parseProcessCompleteText",
        "result": [
          {
            "command": "/usr/bin/python3 /opt/hermes/tools/bot_mode_dm.py --run-delivery query-file /root/.hermes/dm/2f9c.json hermes -p writer chat -c \"Bot Chat\" -Q -q @/root/.hermes/dm/2f9c.json",
            "output": "Message from 🤖 Writer (@writer): Draft is ready, I pushed it to the shared folder.",
            "sid": "proc-2f9c"
          },
          {
            "command": "npm run build",
            "output": "error TS2345: Argument of type string is not assignable.",
            "sid": "proc-aa01"
          }
        ]
      }
    ],
    "test": "parseProcessCompleteText > reads a batch of blocks behind their header"
  },
