{
  // The web client's bundle gate and its tests (`npm run client:check-bundle`).
  // None of it ships; like scripts/golden and scripts/i18n it emits nothing and
  // the root `typecheck` script runs it as its own pass.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["./*.ts", "./*.d.mts", "../../native/web/scripts/*.d.mts"]
}
