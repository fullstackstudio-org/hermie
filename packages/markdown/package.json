{
  "name": "@hermie/markdown",
  "version": "0.0.0",
  "private": true,
  "description": "Pure Markdown core for Hermie: lexer setup, block splitting, preprocessing, highlighting, math and Mermaid parsing and layout",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./attributed": "./src/attributed.ts",
    "./block-model": "./src/block-model.ts",
    "./blocks": "./src/blocks.ts",
    "./code-theme": "./src/code-theme.ts",
    "./highlight": "./src/highlight.ts",
    "./marked-compat": "./src/marked-compat.ts",
    "./math/linear": "./src/math/linear.ts",
    "./math/marked-math": "./src/math/marked-math.ts",
    "./math/metrics": "./src/math/metrics.ts",
    "./math/parse": "./src/math/parse.ts",
    "./math/symbols": "./src/math/symbols.ts",
    "./mermaid/labels": "./src/mermaid/labels.ts",
    "./mermaid/layout": "./src/mermaid/layout.ts",
    "./mermaid/parse": "./src/mermaid/parse.ts",
    "./mermaid/pie": "./src/mermaid/pie.ts",
    "./mermaid/pie-layout": "./src/mermaid/pie-layout.ts",
    "./mermaid/sequence": "./src/mermaid/sequence.ts",
    "./mermaid/sequence-layout": "./src/mermaid/sequence-layout.ts",
    "./plain-text": "./src/plain-text.ts",
    "./preprocess": "./src/preprocess.ts"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14"
  }
}
